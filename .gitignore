# --- .NET ---
[Bb]in/
[Oo]bj/
*.user
.vs/
# `dotnet publish -o publish/...` output — build artifacts, reproducible from source. Rooted so it
# only matches the one at the repo root, not a source directory that happens to be named `publish`.
/publish/

# `scriptsuild-release.ps1` output — the api/ and web/ builds plus the deploy script, staged for
# copying to the server. Rooted for the same reason as `publish/` above. Around 30 MB, and entirely
# reproducible, so it has no business in history.
/release/

# --- Node / React ---
node_modules/
dist/
dist-ssr/
*.local

# --- Logs ---
*.log
npm-debug.log*

# --- Editor / OS ---
.DS_Store
Thumbs.db
.idea/
.qodo/

# --- Claude Code ---
# Scoped rather than a blanket `.claude/`, so shared agent or skill config can still be committed
# deliberately. Worktrees are whole checkouts of this repo; machine-local settings are per-developer.
.claude/worktrees/
.claude/settings.local.json

# --- Env ---
.env
.env.*
!.env.example
