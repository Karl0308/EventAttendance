<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting config for EAMS.Api.

  This file exists in source because `dotnet publish` OVERWRITES the published web.config from a
  template on every publish. Settings applied only on the server are therefore silently lost on the
  next deploy — which is how the first IIS deploy failed: the app had no connection string, threw at
  startup, and IIS reported a bare "HTTP Error 500.30 - ASP.NET Core app failed to start".

  When this file is present the SDK merges it with the generated one instead of discarding it, so
  everything below survives a republish.

  ────────────────────────────────────────────────────────────────────────────────────────────────
  THE CONNECTION STRING IS NOT HERE, AND MUST NOT BE ADDED.
  ────────────────────────────────────────────────────────────────────────────────────────────────
  This file is tracked in git and pushed to GitHub. A `User Id=sa;Password=...` written here is a
  published credential for the whole SQL Server instance, permanently recorded in history where
  deleting it later does not remove it.

  Supply it on the server instead, by whichever route suits the host:

    - IIS Manager -> Application Pools -> <pool> -> Advanced Settings -> Environment Variables, or
    - add it to the DEPLOYED copy of this file, under the <environmentVariables> block below:

        <environmentVariable name="ConnectionStrings__EamsDb"
                             value="Server=.;Database=EAMS;User Id=eams_app;Password=...;TrustServerCertificate=True" />

  Note the DOUBLE underscore: it maps to the ':' in ConnectionStrings:EamsDb. A single underscore
  does not bind, and the app throws "Connection string 'EamsDb' is not configured" — by design, so a
  misconfigured host refuses to boot rather than quietly connecting to nothing (see
  appsettings.json, which deliberately ships without a connection string for the same reason).

  Prefer a login scoped to the EAMS database over `sa`. This build has no authentication on its own
  endpoints (ADR-001 D-6), so a leak of instance-wide credentials reaches every other database on
  the server, not just this one.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!--
        WebDAV, removed. Without these two lines every PUT and DELETE in this API answers 405 on IIS
        and works perfectly everywhere else.

        IIS installs WebDAV enabled by default. Its module claims PUT and DELETE and answers 405
        before the ASP.NET Core Module is reached, so the request never arrives at the application:
        there is no log line, no exception, and no trace id, because from the application's point of
        view the call did not happen. Kestrel has no WebDAV, so `dotnet run` and the whole test suite
        are unaffected - the failure exists only where it cannot be reproduced locally.

        It cost a real deployment: DELETE /events/{id}/attendees/groups/{id} returned "405: no detail
        supplied" while the same call succeeded on a developer machine. Eleven routes were affected -
        editing a student or an event, deleting either, removing a card, changing the current term -
        all of them silently, because a 405 reads as "the client sent the wrong verb" rather than as
        "the server refused to route it".

        BOTH lines are required. Removing the module stops it handling the request; removing the
        handler stops it claiming the verb in the first place. Removing one and not the other leaves
        the 405 in place, which is the usual reason this fix is reported as not working.
      -->
      <modules>
        <remove name="WebDAVModule" />
      </modules>

      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <!--
        stdoutLogEnabled is false here because the log grows without bound and can capture
        configuration values. Turn it on temporarily on the server to diagnose a startup failure:
        set it to "true", create the `logs` folder (the module does not create it, and a missing
        folder silently produces no log at all), reproduce, then read logs\stdout_*.log.
      -->
      <aspNetCore processPath="dotnet"
                  arguments=".\EAMS.Api.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <!--
            Development, not Production, and this is load-bearing rather than an oversight.

            Seeding, Swagger and the well-known development kiosk key are all gated on
            IsDevelopment(). On Production the seed is skipped, so no Term row is created, and the
            roster importer takes TermId as an *input* rather than creating one — so a Production
            host starts with an empty term picker and cannot stage a batch until someone authors a
            term on the SPA's /terms page (D-53). That is a first-run step, not a dead end; see
            docs/DEPLOY-IIS.md for the order.

            The tradeoff: Development also seeds a device key whose value is public in this repo.
            That is acceptable only on a host that is not reachable from outside the network. Before
            this build serves anyone but testers, Technical Plan §11 (JWT + RBAC) has to land — at
            which point this value should become Production and the seeded term be replaced by a
            real one.
          -->
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Development" />

          <!--
            The admin SPA's origin: scheme + host only, no path and no trailing slash. A browser's
            Origin header never carries a path, so "https://dev.iloilosupermart.com/eams" matches
            nothing — every request then fails CORS in the browser while the server logs nothing at
            all, which is a hard failure to diagnose from the server side.

            Outside Development an unconfigured API admits NO origin by design, so this is required
            rather than a convenience. Additional origins are __1, __2, and so on.

            http, NOT https: the Default Web Site has no HTTPS binding. The scheme is part of an
            origin, so http:// and https:// do not match each other — a mismatch here blocks every
            response in the browser while the request itself succeeds and the server logs nothing.
            This must stay in step with VITE_API_BASE_URL in web-admin/.env.production.
          -->
          <environmentVariable name="Cors__AllowedOrigins__0" value="http://dev.iloilosupermart.com" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
