{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"

  // No ConnectionStrings block, deliberately. This file is the base layer every environment
  // inherits, so a connection string here is the *production* default — and the one that used to
  // sit here pointed at a developer's .\SQLEXPRESS with TrustServerCertificate=True. It also
  // disarmed the "not configured" throw in DependencyInjection: with a value always present, that
  // guard could never fire, so a production host with a missing ConnectionStrings__EamsDb would
  // start happily and quietly connect to nothing useful instead of refusing to boot.
  //
  // Local development gets it from appsettings.Development.json; anything else supplies
  // ConnectionStrings__EamsDb through the environment.
}
