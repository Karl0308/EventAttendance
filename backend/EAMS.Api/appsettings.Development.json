{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  // Local developer instance. Windows integrated auth, so no secret lives here; a different
  // machine or a shared server overrides this with ConnectionStrings__EamsDb in the environment.
  "ConnectionStrings": {
    "EamsDb": "Server=.\\SQLEXPRESS;Database=EAMS;Trusted_Connection=True;TrustServerCertificate=True"
  },

  // The admin SPA's Vite dev server. Stated here rather than left to the code default so the port is
  // editable without a rebuild — Vite picks the next free port when 5173 is taken. Development only:
  // there is no deployed front end yet, and LocalDevelopmentCors admits nothing outside Development
  // until this setting names a real origin.
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  }
}
