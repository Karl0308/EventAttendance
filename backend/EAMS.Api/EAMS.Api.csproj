<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- TargetFramework / Nullable / ImplicitUsings come from backend/Directory.Build.props. -->

  <!--
    Phase 4e. The OpenAPI document is the deliverable of Phase 4 — it replaces a hand-written markdown
    handoff that could drift from the code without anything failing. The XML file is what carries the
    controllers' reasoning into it; see EamsOpenApi.XmlCommentPaths, which throws rather than silently
    generating a documentation-free document if this property is ever turned off.

    CS1591 / CS1573 suppressed for the reason EAMS.Application.csproj records at length; CS1574
    (unresolvable cref) deliberately left on, for the reason recorded there too.
  -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <!--
    §11 needs somewhere for a developer's secrets to live that is NOT inside the repository:
    Jwt:SigningKey, without which this host refuses to start, and the optional
    Seed:DevelopmentSuperAdminPassword. WebApplicationBuilder adds the user-secrets provider only in
    the Development environment and only when this property is present, so it is the whole of what
    makes `dotnet user-secrets set (key) (value)` against this project work.

    The id is a stable random GUID and is meant to be committed — it names a folder under the
    developer's own profile, and nothing secret is derived from it.
  -->
  <PropertyGroup>
    <UserSecretsId>eams-api-3f7c1a90-2b64-4d18-9a55-6c0e8b21d4af</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />

    <!--
      Phase 6b: §11's Bearer scheme. Version-matched to the 9.0.x runtime this host targets, for the
      reason EAMS.Tests.csproj records about EF Core — an authentication package on a different minor
      line than the framework it plugs into is a validation pipeline that behaves differently here
      than in production.

      It lives here and NOT in EAMS.Infrastructure, deliberately. This package is what brings the
      signing-key types (Microsoft.IdentityModel.Tokens) into a project, and the whole of D-74 is that
      the layer holding Users.PasswordHash must not also be able to mint a credential for it. See
      TokenIssuer.
    -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.14" />
  </ItemGroup>

  <!--
    Top-level statements compile to an `internal partial class Program`, so
    WebApplicationFactory<Program> cannot see it from another assembly without this. The alternative
    — declaring `public partial class Program { }` in Program.cs — widens the API surface of the host
    permanently to serve one test; this grants exactly one assembly exactly the access it needs.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="EAMS.Tests" />
  </ItemGroup>

  <!--
    Layering rule (Technical Plan §3): Api → Application → Domain.

    The Infrastructure reference exists only so the composition root can call
    AddEamsInfrastructure(). It cannot be used for anything else: every other type in that
    assembly is `internal`, so a controller that tries to inject EamsDbContext or a service
    implementation is a compile error (CS0122), not a review finding.

    The reference cannot be removed outright — a runtime-only ProjectReference does not flow
    EF Core's own assemblies into this project's output, and adding them back here would be a
    worse layering violation than the one it fixed. See the Phase 0b report.
  -->
  <ItemGroup>
    <ProjectReference Include="..\EAMS.Application\EAMS.Application.csproj" />
    <ProjectReference Include="..\EAMS.Infrastructure\EAMS.Infrastructure.csproj" />
  </ItemGroup>

</Project>
