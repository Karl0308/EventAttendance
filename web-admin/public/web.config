<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS deep-link fallback and response headers for the admin SPA. Lives in `public/` so Vite copies it
  verbatim into `dist/` on every build.

  It used to have a counterpart: CI copied `index.html` to `404.html` so GitHub Pages, which has no
  server to configure, could do the same job. That deployment was removed with the login screen
  (Phase 6c) and this file is now the ONLY deep-link fallback the app has — so `httpErrors` below is
  load-bearing rather than one of two belts.

  Without this, IIS resolves /students/import against the filesystem, finds no such directory, and
  returns its own 404 — so the app works when you click through from the home page and breaks the
  moment anyone refreshes or pastes a link. react-router only sees a path if index.html is served.

  The `httpErrors` form (rather than a URL Rewrite rule) is deliberate: it needs no module installed
  on the server. URL Rewrite is a separate IIS download and is often absent on a fresh VM, which
  fails as a 500.19 configuration error that reads as though the whole site is broken.
-->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!--
      `existingResponse="Replace"` is what makes this apply to IIS's own static-file 404 rather than
      only to responses an application generated. `responseMode="File"` returns index.html's bytes
      with the original 404 status code, which is correct: the SPA boots, react-router reads the
      path, and renders either the route or its own not-found. A rewrite would return 200 for URLs
      that genuinely do not exist and let crawlers index them.
    -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" />
      <error statusCode="404" path="index.html" responseMode="File" />
    </httpErrors>

    <!--
      Response headers. The Content-Security-Policy is the one worth explaining.

      **It is defence in depth, not what holds the session together.** The refresh token is an
      `httpOnly` cookie no script can read and the access token lives in a JavaScript variable that
      dies with the tab, so the account-takeover shape a CSP usually guards against is already closed
      by where the credentials live. What this buys is the next layer: a script injected into a page
      that already has a live session cannot reach a host of its own to send anything to.

      It lives here rather than in a `<meta>` tag in `index.html` because a meta CSP applies in
      development too, and Vite's dev server serves inline module scripts and an HMR client that a
      policy this strict stops dead — so the version everyone tested would be the loosened one.

      Line by line:
        default-src 'self'    — everything not named below comes from this origin.
        script-src 'self'     — Vite emits external module chunks only. NO 'unsafe-inline'.
        style-src … 'unsafe-inline' — Emotion (MUI's engine) injects a <style> element per rule at
                                runtime. This is the one relaxation, and it is MUI's architecture
                                rather than a shortcut; removing it needs a nonce the static host
                                cannot generate.
        img-src 'self' data:  — `data:` for MUI's inlined SVG icons. Note for whoever renders a
                                student photo from `Student.photoUrl` one day: that URL is
                                operator-supplied and points wherever they typed, so this is the line
                                that will refuse it, and widening it to `https:` is the decision to
                                take deliberately rather than discover.
        connect-src 'self'    — the API is the same origin by design (see `web-admin/.env.example`).
                                If the API is ever moved to its own host, this line refuses every
                                request before CORS is even consulted.
        frame-ancestors 'none' — this app is never framed; the session cookie is `SameSite=Strict`,
                                but clickjacking does not need a cross-site request.
        form-action 'self', base-uri 'self', object-src 'none' — standard hardening.
    -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="same-origin" />
      </customHeaders>
    </httpProtocol>

    <staticContent>
      <!-- IIS has no MIME map for these by default and serves a 404 for the font and .mjs chunks. -->
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".mjs" mimeType="text/javascript" />
    </staticContent>
  </system.webServer>
</configuration>
