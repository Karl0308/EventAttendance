{
  /* The Playwright suite, type-checked as its own project.
   *
   * Separate from `tsconfig.app.json` and `tsconfig.test.json` so Playwright's ambient types cannot reach
   * the program that builds the SPA, and so `vitest` (which only collects `test/` and `src/`) never sees
   * these files. Referenced from `tsconfig.json`, so `tsc -b` - the first half of `npm run build` -
   * type-checks the fixtures against `src/types.ts`: a drifted DTO fails the build, not a QA session.
   */
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["e2e", "playwright.config.ts"]
}
